{
  // Files listed here are checked under the strict settings below. The remaining legacy
  // scripts live in tsconfig.legacy.json; a file moves here once it is fully typed.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "scripts/build.mjs",
    "vite.config.ts",
    "src/ts/globals.d.ts",
    "src/ts/manifest-inject.ts",
    "src/ts/theme-language.ts",
    "src/ts/gallery.ts"
  ]
}
